    <string name="pairing_label">Mac 连接配对码</string>
    <string name="pairing_hint">在 Mac 菜单栏打开「通知桥」，点击连接手机后输入这 6 位数字。</string>
    <string name="mac_hint_running">连接成功后，Mac 会以系统通知显示短信、微信等新消息。</string>
    <string name="mac_hint_stopped">点击上方「启动同步」，再回到 Mac 完成连接。</string>

    <string name="privacy_title">隐私</string>
    <string name="privacy_body">通知内容只在手机与 Mac 的蓝牙连接中传输，不经过互联网，也不会写入服务器。配对码仅在当前连接中有效。</string>
    <string name="limitations_title">限制</string>
    <string name="limitations_body">iPhone 不适用：iOS 不允许第三方 App 读取系统通知。微信、短信等能否显示具体内容，取决于手机通知本身是否展示详情；部分系统会隐藏锁屏通知内容。</string>
    <string name="version_footer">NotifyBridge 0.1 · Android 8.0+ · 需要一个蓝牙适配器正常的 Mac</string>

    <string name="relay_channel_name">通知同步</string>
    <string name="relay_channel_description">保持与 Mac 的低功耗蓝牙连接</string>

